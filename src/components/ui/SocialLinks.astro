---
/**
 * Inline SVG social icons — no Font Awesome, no icon library.
 * Order and URLs come from src/consts.ts.
 */
import { SOCIAL_LINKS } from '~/consts';

interface Props {
  /** Size in px. Default 24. */
  size?: number;
  class?: string;
}

const { size = 24, class: extraClass = '' } = Astro.props;

// Minimal monoline SVGs for Twitter/X, TikTok, YouTube.
const ICONS: Record<string, string> = {
  Twitter: `<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>`,
  TikTok: `<path d="M21 7.917a8.96 8.96 0 0 1-5.34-1.75v8.083a6 6 0 1 1-6-6c.31 0 .613.024.911.069v3.115a3 3 0 1 0 2.089 2.846V2h3a5.96 5.96 0 0 0 5.34 5.917z"/>`,
  YouTube: `<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.546 15.568V8.432L15.818 12z"/>`,
};
---

<ul class={`flex items-center gap-4 ${extraClass}`.trim()}>
  {SOCIAL_LINKS.map((social) => (
    <li>
      <a
        href={social.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${social.title} (${social.handle})`}
        class="inline-flex items-center justify-center text-ink/70 transition hover:text-accent focus-visible:text-accent focus-visible:outline-none"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width={size}
          height={size}
          fill="currentColor"
          aria-hidden="true"
          set:html={ICONS[social.title] ?? ''}
        />
      </a>
    </li>
  ))}
</ul>
