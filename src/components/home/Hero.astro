---
/**
 * Homepage hero — the conversion engine.
 *
 * 100vh full-bleed background art, darkened with a gradient so the wordmark
 * and CTAs read against any pixel of the image. Centered, vertically stacked.
 * The big Wishlist button here is the "real" CTA — the sticky bar that
 * appears after scroll is the safety net.
 *
 * "Watch Trailer" anchors to #trailer, which the YouTubeEmbed listens for
 * and starts playback automatically.
 */
import { Image } from 'astro:assets';
import Section from '~/components/ui/Section.astro';
import WishlistButton from '~/components/ui/WishlistButton.astro';
import wordmark from '~/assets/logos/wordmark.png';
import { PRESS_QUOTES } from '~/data/press-quotes';

// The first entry in PRESS_QUOTES (if any) renders above the wishlist button.
// When the array is empty, nothing renders — slot is ready, not visible.
const featuredQuote = PRESS_QUOTES[0];
---

<header class="relative min-h-svh flex items-center justify-center overflow-hidden">
  {/*
    NOTE: min-h-svh (small viewport height), not min-h-screen / 100vh.
    iOS Safari's 100vh equals the LARGEST viewport (URL bar hidden), so
    on initial load with URL bar visible, a 100vh element is taller than
    the actually-visible area — the sentinel at its bottom falls below
    the viewport and the sticky CTA bar shows over the hero.
    svh is the smallest viewport (URL bar shown), so it always fits.
  */}
  {/* Background — looping cinematic moment from the trailer. The poster
       JPG is a 28KB fallback that paints instantly while the video buffers
       and persists if the browser refuses autoplay. */}
  <video
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/videos/hero-loop-poster.jpg"
    class="absolute inset-0 w-full h-full object-cover -z-10"
    aria-hidden="true"
  >
    <source src="/videos/hero-loop.webm" type="video/webm" />
    <source src="/videos/hero-loop.mp4" type="video/mp4" />
  </video>

  {/* Gradient overlay — guarantees text contrast over any frame of the art */}
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-b from-bg-dark/30 via-bg-dark/55 to-bg-dark"
    aria-hidden="true"
  />

  {/* Vignette for extra side darkening on wide screens */}
  <div
    class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_center,transparent_30%,rgba(26,20,16,0.55)_100%)]"
    aria-hidden="true"
  />

  <Section spacing="generous" width="page" class="relative z-10 text-center">
    {/* Wordmark — H1 for SEO, but it's an image so the visual weight comes from the file */}
    <h1 class="flex justify-center">
      <Image
        src={wordmark}
        alt="ToyBox Security"
        widths={[480, 720, 960]}
        sizes="(min-width: 768px) 720px, 80vw"
        loading="eager"
        fetchpriority="high"
        class="w-full max-w-xl drop-shadow-[0_8px_24px_rgba(0,0,0,0.45)]"
      />
    </h1>

    {/* Tagline */}
    <p class="mt-8 font-display uppercase text-display-sm md:text-display-md text-ink drop-shadow-[0_4px_16px_rgba(0,0,0,0.6)] leading-[1.05]">
      Set traps. Steal the loot.<br />Catch the kid.
    </p>

    {/* Social-proof slot — renders only when there's a press quote to show. */}
    {featuredQuote && (
      <figure class="mt-10 max-w-xl mx-auto">
        <blockquote class="text-sm md:text-base italic text-ink leading-relaxed drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]">
          &ldquo;{featuredQuote.text}&rdquo;
        </blockquote>
        <figcaption class="mt-2 text-xs uppercase tracking-widest text-accent">
          {featuredQuote.url ? (
            <a href={featuredQuote.url} target="_blank" rel="noopener noreferrer" class="hover:underline">
              — {featuredQuote.attribution}
            </a>
          ) : (
            <span>— {featuredQuote.attribution}</span>
          )}
        </figcaption>
      </figure>
    )}

    {/* Primary CTA — Wishlist is the sole button; "Watch Trailer" is a quieter text link below. */}
    <div class={`${featuredQuote ? 'mt-6' : 'mt-10'} flex justify-center`}>
      <WishlistButton utmMedium="hero_cta" size="xl" />
    </div>

    <a
      href="#trailer"
      class="mt-3 inline-flex items-center justify-center gap-1.5 min-h-11 px-3 -mx-3 rounded text-sm uppercase tracking-widest text-ink/85 hover:text-accent transition focus-visible:outline-none focus-visible:text-accent focus-visible:ring-2 focus-visible:ring-accent"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14" aria-hidden="true">
        <path d="M8 5v14l11-7z"/>
      </svg>
      Watch the trailer
    </a>
  </Section>

  {/* Scroll affordance */}
  <a
    href="#trailer"
    aria-label="Scroll to trailer"
    class="hero-chevron absolute bottom-8 left-1/2 -translate-x-1/2 z-10 text-ink/70 hover:text-accent transition-colors focus-visible:outline-none focus-visible:text-accent"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32" aria-hidden="true">
      <polyline points="6 9 12 15 18 9" />
    </svg>
  </a>

  {/* IntersectionObserver sentinel — when this leaves the viewport, the sticky CTA bar tints in.
       Inset 16px up from the bottom so we have a buffer for any iOS Safari
       URL-bar / dvh edge cases. */}
  <div data-hero-sentinel class="absolute bottom-16 left-0 right-0 h-1 pointer-events-none" aria-hidden="true" />
</header>

<style>
  @keyframes hero-chevron-bounce {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 6px); }
  }
  .hero-chevron {
    animation: hero-chevron-bounce 2.4s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-chevron { animation: none; }
  }
</style>
