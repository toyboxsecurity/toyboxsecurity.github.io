---
/**
 * Steam store widget. Desktop-only.
 *
 * The official iframe is 646×190 native and does not scale. On mobile,
 * the WishlistCalloutBand directly above already handles the wishlist
 * CTA, so this entire section hides to avoid two back-to-back "click
 * the green button" sections that would render essentially identical
 * on a phone.
 */
import Section from '~/components/ui/Section.astro';
import { STEAM_WIDGET_URL, SITE_TITLE } from '~/consts';
---

<Section spacing="default" variant="dark" class="hidden md:block border-t border-ink/10 text-center">
  <p class="text-xs uppercase tracking-widest text-accent mb-3">On Steam</p>
  <h2 class="font-display text-display-md uppercase mb-10">See it on Steam</h2>

  <iframe
    src={STEAM_WIDGET_URL}
    width="646"
    height="190"
    frameborder="0"
    class="mx-auto rounded-lg overflow-hidden shadow-2xl"
    title={`${SITE_TITLE} on Steam`}
    loading="lazy"
  ></iframe>
</Section>
