---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import Section from '~/components/ui/Section.astro';

// Drafts are filtered in production. In dev, they render too so the owner can preview.
const posts = (await getCollection('news', ({ data }) => import.meta.env.PROD ? !data.draft : true))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<PageLayout
  title="News"
  description="Devblog posts and updates from thatcozydev on the development of ToyBox Security."
>
  <Section spacing="default" class="pt-32">
    <header class="mb-12">
      <p class="text-xs uppercase tracking-widest text-accent mb-3">Devblog</p>
      <h1 class="font-display text-display-lg uppercase leading-[0.95]">News</h1>
    </header>

    {posts.length === 0 ? (
      <p class="text-ink-muted">No posts yet — check back soon.</p>
    ) : (
      <ul class="space-y-10">
        {posts.map((post) => (
          <li>
            <a
              href={`/news/${post.slug}`}
              class="group grid md:grid-cols-[1fr_2fr] gap-6 items-center hover:bg-bg-light/[0.03] rounded-xl p-4 -m-4 transition"
            >
              {post.data.heroImage ? (
                <Image
                  src={post.data.heroImage}
                  alt=""
                  widths={[400, 600]}
                  sizes="(min-width: 768px) 360px, 100vw"
                  class="rounded-lg w-full h-48 md:h-auto object-cover aspect-video"
                  loading="lazy"
                />
              ) : (
                <div class="rounded-lg w-full aspect-video bg-bg-light/[0.04] ring-1 ring-ink/10 flex items-center justify-center">
                  <span class="font-display text-display-md text-ink/15 uppercase">Devblog</span>
                </div>
              )}
              <div>
                {post.data.draft && (
                  <span class="inline-block text-[10px] uppercase tracking-widest bg-secondary text-bg-dark px-2 py-0.5 rounded mb-2">
                    Draft
                  </span>
                )}
                <p class="text-xs uppercase tracking-widest text-ink-muted mb-2">
                  <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
                </p>
                <h2 class="font-display text-2xl md:text-3xl uppercase leading-tight group-hover:text-accent transition">
                  {post.data.title}
                </h2>
                <p class="text-ink-muted mt-2 leading-relaxed">{post.data.description}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </Section>
</PageLayout>
